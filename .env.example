# Base mainnet RPC, used by the anvil fork harness.
ETH_NODE_URI_BASE_MAINNET=https://mainnet.base.org

# Optional: pin the fork block so anvil reuses its on-disk RPC cache between runs.
# Leave empty to fork the current head.
BASE_FORK_BLOCK_NUMBER=

# No keys needed: the fork tests sign with the accounts the local anvil node already unlocks.
